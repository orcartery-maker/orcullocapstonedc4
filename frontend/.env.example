# Address of the Laravel API. Use your computer's LAN IP to test from a phone
# (e.g. http://192.168.1.10:8000/api) or your hosted API URL in production.
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: where place images are served from (defaults to the API host + /storage).
# VITE_STORAGE_URL=http://127.0.0.1:8000/storage
